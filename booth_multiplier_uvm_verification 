`include "uvm_macros.svh"

package booth_uvm_pkg;

    import uvm_pkg::*;

    localparam int N_BITS = 8; // change this single value to resize everything

    // -------------------------------------------------------------
    // TRANSACTION (uvm_sequence_item)
    // -------------------------------------------------------------
    class booth_transaction extends uvm_sequence_item;

        rand bit signed [N_BITS-1:0]   multiplicand;
        rand bit signed [N_BITS-1:0]   multiplier;
        bit signed [2*N_BITS-1:0]      product;
        bit                            done;

        constraint c_valid_range {
            multiplicand inside {[-(1<<(N_BITS-1)) : (1<<(N_BITS-1))-1]};
            multiplier   inside {[-(1<<(N_BITS-1)) : (1<<(N_BITS-1))-1]};
        }

        `uvm_object_utils_begin(booth_transaction)
            `uvm_field_int(multiplicand, UVM_ALL_ON)
            `uvm_field_int(multiplier,   UVM_ALL_ON)
            `uvm_field_int(product,      UVM_ALL_ON)
            `uvm_field_int(done,         UVM_ALL_ON)
        `uvm_object_utils_end

        function new(string name = "booth_transaction");
            super.new(name);
        endfunction

    endclass


    // -------------------------------------------------------------
    // SEQUENCE (random + directed stimulus)
    // -------------------------------------------------------------
    class booth_sequence extends uvm_sequence #(booth_transaction);

        `uvm_object_utils(booth_sequence)

        int num_random = 50;

        function new(string name = "booth_sequence");
            super.new(name);
        endfunction

        task body();
            booth_transaction tr;

            repeat (num_random) begin
                tr = booth_transaction::type_id::create("tr");
                start_item(tr);
                if (!tr.randomize())
                    `uvm_error("SEQ", "Randomization failed")
                finish_item(tr);
            end

            add_directed_tests();
        endtask

        // Corner / edge cases not guaranteed by pure randomization
        task add_directed_tests();
            send(0, 0);       // 0 x 0            -> zero x zero
            send(127, 127);   // max_pos x max_pos -> pos x pos
            send(-128, -128); // min_neg x min_neg -> neg x neg (Booth corner case)
            send(127, -128);  // max_pos x min_neg -> pos x neg
            send(-1, -1);     // -1 x -1           -> neg x neg
            send(0, -5);      // zero x neg
            send(0, 5);       // zero x pos
            send(-5, 0);      // neg x zero
            send(5, 0);       // pos x zero
        endtask

        task send(int a, int b);
            booth_transaction tr;
            tr = booth_transaction::type_id::create("tr");
            start_item(tr);
            tr.multiplicand = a;
            tr.multiplier   = b;
            finish_item(tr);
        endtask

    endclass


    // -------------------------------------------------------------
    // DRIVER
    // -------------------------------------------------------------
    class booth_driver extends uvm_driver #(booth_transaction);

        `uvm_component_utils(booth_driver)

        virtual booth_if vif;

        function new(string name, uvm_component parent);
            super.new(name, parent);
        endfunction

        function void build_phase(uvm_phase phase);
            super.build_phase(phase);
            assert (uvm_config_db#(virtual booth_if)::get(this, "", "vif", vif))
                else `uvm_fatal("DRV", "Virtual interface not set for driver")
        endfunction

        task reset_dut();
            vif.drv_cb.rst          <= 1'b1;
            vif.drv_cb.start        <= 1'b0;
            vif.drv_cb.multiplicand <= '0;
            vif.drv_cb.multiplier   <= '0;
            repeat (3) @(vif.drv_cb);
            vif.drv_cb.rst <= 1'b0;
            @(vif.drv_cb);
            `uvm_info("DRV", "Reset complete", UVM_LOW)
        endtask

        task run_phase(uvm_phase phase);
            booth_transaction tr;
            reset_dut();
            forever begin
                seq_item_port.get_next_item(tr);
                drive(tr);
                seq_item_port.item_done();
            end
        endtask

        task drive(booth_transaction tr);
            vif.drv_cb.multiplicand <= tr.multiplicand;
            vif.drv_cb.multiplier   <= tr.multiplier;
            vif.drv_cb.start        <= 1'b1;
            @(vif.drv_cb);
            vif.drv_cb.start        <= 1'b0;

            do begin
                @(vif.drv_cb);
            end while (!vif.drv_cb.done);

            `uvm_info("DRV", $sformatf("Drove multiplicand=%0d multiplier=%0d",
                       tr.multiplicand, tr.multiplier), UVM_HIGH)
        endtask

    endclass


    // -------------------------------------------------------------
    // MONITOR
    // -------------------------------------------------------------
    class booth_monitor extends uvm_monitor;

        `uvm_component_utils(booth_monitor)

        virtual booth_if vif;
        uvm_analysis_port #(booth_transaction) ap;

        function new(string name, uvm_component parent);
            super.new(name, parent);
            ap = new("ap", this);
        endfunction

        function void build_phase(uvm_phase phase);
            super.build_phase(phase);
            assert (uvm_config_db#(virtual booth_if)::get(this, "", "vif", vif))
                else `uvm_fatal("MON", "Virtual interface not set for monitor")
        endfunction

        task run_phase(uvm_phase phase);
            booth_transaction tr;
            bit prev_done = 0;
            forever begin
                @(vif.mon_cb);
                if (vif.mon_cb.done && !prev_done) begin
                    tr = booth_transaction::type_id::create("tr");
                    tr.multiplicand = vif.mon_cb.multiplicand;
                    tr.multiplier   = vif.mon_cb.multiplier;
                    tr.product      = vif.mon_cb.product;
                    tr.done         = 1'b1;
                    `uvm_info("MON", $sformatf("Captured multiplicand=%0d multiplier=%0d product=%0d",
                               tr.multiplicand, tr.multiplier, tr.product), UVM_HIGH)
                    ap.write(tr);
                end
                prev_done = vif.mon_cb.done;
            end
        endtask

    endclass


    // -------------------------------------------------------------
    // SCOREBOARD
    // -------------------------------------------------------------
    class booth_scoreboard extends uvm_scoreboard;

        `uvm_component_utils(booth_scoreboard)

        uvm_analysis_imp #(booth_transaction, booth_scoreboard) ap_imp;

        int pass_count = 0;
        int fail_count = 0;

        function new(string name, uvm_component parent);
            super.new(name, parent);
            ap_imp = new("ap_imp", this);
        endfunction

        // A9: IMMEDIATE ASSERTION -- functional correctness check.
        //     Unlike the concurrent (clocked) assertions in booth_rtl.sv /
        //     booth_if.sv, this is an *immediate* assertion: it has no
        //     notion of time/clock and is evaluated the instant write()
        //     executes. This is the idiomatic way to do assertion-based
        //     checking inside a UVM class (classes have no clock of
        //     their own, so `assert property(...)` cannot be used here).
        function void write(booth_transaction tr);
            bit signed [2*N_BITS-1:0] expected;
            expected = tr.multiplicand * tr.multiplier;

            assert (expected === tr.product) begin
                pass_count++;
                `uvm_info("SCB", $sformatf("PASS : %0d * %0d = %0d",
                           tr.multiplicand, tr.multiplier, tr.product), UVM_LOW)
            end
            else begin
                fail_count++;
                `uvm_error("SCB", $sformatf("ASSERTION FAILED (FAIL) : %0d * %0d = %0d (expected %0d)",
                           tr.multiplicand, tr.multiplier, tr.product, expected))
            end
        endfunction

        function void report_phase(uvm_phase phase);
            `uvm_info("SCB", "=========================================", UVM_LOW)
            `uvm_info("SCB", $sformatf("SCOREBOARD REPORT: TOTAL=%0d PASS=%0d FAIL=%0d",
                       pass_count + fail_count, pass_count, fail_count), UVM_LOW)
            `uvm_info("SCB", "=========================================", UVM_LOW)
        endfunction

    endclass


    // -------------------------------------------------------------
    // COVERAGE (manual bins -- Vivado xsim covergroups not supported)
    // -------------------------------------------------------------
    class booth_coverage extends uvm_subscriber #(booth_transaction);

        `uvm_component_utils(booth_coverage)

        int unsigned bin_multiplicand[3]; // 0=neg,1=zero,2=pos
        int unsigned bin_multiplier[3];
        int unsigned bin_cross[3][3];
        int unsigned total_samples;

        function new(string name, uvm_component parent);
            super.new(name, parent);
            total_samples = 0;
            foreach (bin_multiplicand[i]) bin_multiplicand[i] = 0;
            foreach (bin_multiplier[i])   bin_multiplier[i]   = 0;
            foreach (bin_cross[i,j])      bin_cross[i][j]     = 0;
        endfunction

        function int bin_index(bit signed [N_BITS-1:0] val);
            if (val < 0)       return 0;
            else if (val == 0) return 1;
            else                return 2;
        endfunction

        function void write(booth_transaction t);
            int a_idx, b_idx;
            a_idx = bin_index(t.multiplicand);
            b_idx = bin_index(t.multiplier);
            bin_multiplicand[a_idx]++;
            bin_multiplier[b_idx]++;
            bin_cross[a_idx][b_idx]++;
            total_samples++;
        endfunction

        function void report_phase(uvm_phase phase);
            int hit_bins, total_bins;
            string names[3];
            names[0] = "neg"; names[1] = "zero"; names[2] = "pos";

            hit_bins = 0;
            total_bins = 3 + 3 + 9;

            `uvm_info("COV", "=========================================", UVM_LOW)
            `uvm_info("COV", $sformatf("Total samples = %0d", total_samples), UVM_LOW)
            foreach (bin_multiplicand[i]) begin
                `uvm_info("COV", $sformatf("multiplicand %-5s : %0d hits", names[i], bin_multiplicand[i]), UVM_LOW)
                if (bin_multiplicand[i] > 0) hit_bins++;
            end
            foreach (bin_multiplier[i]) begin
                `uvm_info("COV", $sformatf("multiplier   %-5s : %0d hits", names[i], bin_multiplier[i]), UVM_LOW)
                if (bin_multiplier[i] > 0) hit_bins++;
            end
            foreach (bin_cross[i,j]) begin
                `uvm_info("COV", $sformatf("cross %-5s x %-5s : %0d hits", names[i], names[j], bin_cross[i][j]), UVM_LOW)
                if (bin_cross[i][j] > 0) hit_bins++;
            end
            `uvm_info("COV", $sformatf("FUNCTIONAL COVERAGE = %0.2f %%", (hit_bins * 100.0) / total_bins), UVM_LOW)
            `uvm_info("COV", "=========================================", UVM_LOW)
        endfunction

    endclass


    // -------------------------------------------------------------
    // AGENT
    // -------------------------------------------------------------
    class booth_agent extends uvm_agent;

        `uvm_component_utils(booth_agent)

        booth_driver               drv;
        uvm_sequencer #(booth_transaction) sqr;
        booth_monitor               mon;

        function new(string name, uvm_component parent);
            super.new(name, parent);
        endfunction

        function void build_phase(uvm_phase phase);
            super.build_phase(phase);
            drv = booth_driver::type_id::create("drv", this);
            sqr = uvm_sequencer#(booth_transaction)::type_id::create("sqr", this);
            mon = booth_monitor::type_id::create("mon", this);
        endfunction

        function void connect_phase(uvm_phase phase);
            drv.seq_item_port.connect(sqr.seq_item_export);
        endfunction

    endclass


    // -------------------------------------------------------------
    // ENVIRONMENT
    // -------------------------------------------------------------
    class booth_env extends uvm_env;

        `uvm_component_utils(booth_env)

        booth_agent      agent;
        booth_scoreboard scb;
        booth_coverage   cov;

        function new(string name, uvm_component parent);
            super.new(name, parent);
        endfunction

        function void build_phase(uvm_phase phase);
            super.build_phase(phase);
            agent = booth_agent::type_id::create("agent", this);
            scb   = booth_scoreboard::type_id::create("scb", this);
            cov   = booth_coverage::type_id::create("cov", this);
        endfunction

        function void connect_phase(uvm_phase phase);
            agent.mon.ap.connect(scb.ap_imp);        // scoreboard (custom analysis_imp)
            agent.mon.ap.connect(cov.analysis_export); // coverage (uvm_subscriber built-in port)
        endfunction

    endclass


    // -------------------------------------------------------------
    // TEST
    // -------------------------------------------------------------
    class booth_test extends uvm_test;

        `uvm_component_utils(booth_test)

        booth_env env;

        function new(string name, uvm_component parent);
            super.new(name, parent);
        endfunction

        function void build_phase(uvm_phase phase);
            super.build_phase(phase);
            env = booth_env::type_id::create("env", this);
        endfunction

        task run_phase(uvm_phase phase);
            booth_sequence seq;
            phase.raise_objection(this);

            seq = booth_sequence::type_id::create("seq");
            seq.num_random = 50;
            seq.start(env.agent.sqr);

            // wait until scoreboard has processed all transactions
            // (num_random random txns + 9 directed corner-case txns)
            wait (env.scb.pass_count + env.scb.fail_count >= (seq.num_random + 9));

            `uvm_info("TEST", "SIMULATION COMPLETE", UVM_LOW)
            phase.drop_objection(this);
        endtask

    endclass

endpackage